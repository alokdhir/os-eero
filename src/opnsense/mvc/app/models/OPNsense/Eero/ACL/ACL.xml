<acl>
    <page-eero>
        <name>eero</name>
        <patterns>
            <pattern>ui/eero/*</pattern>
            <pattern>api/eero/report/*</pattern>
            <pattern>api/eero/account/*</pattern>
            <pattern>api/eero/settings/*</pattern>
            <pattern>api/eero/service/*</pattern>
        </patterns>
    </page-eero>
    <page-eero-units>
        <name>eero: rename units</name>
        <patterns>
            <pattern>api/eero/units/rename</pattern>
        </patterns>
    </page-eero-units>
    <page-eero-reboot>
        <name>eero: reboot units</name>
        <patterns>
            <pattern>api/eero/units/reboot</pattern>
        </patterns>
    </page-eero-reboot>
</acl>
