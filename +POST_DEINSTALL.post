#!/bin/sh

# Python's byte-code caches are not in the package: remove them so the directory goes too
rm -rf /usr/local/opnsense/scripts/eero/__pycache__ /usr/local/opnsense/scripts/eero/lib/__pycache__
rmdir /usr/local/opnsense/scripts/eero/lib /usr/local/opnsense/scripts/eero 2>/dev/null || :

# the data stays until you delete it; an upgrade's install creates the user again, with the same uid
pw userdel eero >/dev/null 2>&1 || :
